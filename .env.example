# Copy this file to .env before running `docker compose up`.
# These only configure the source Postgres and ClickHouse destination --
# PeerDB's own internal catalog/MinIO credentials are fixed in
# docker-compose.yml because they never leave the docker network.

# Source Postgres (the "production" database being CDC'd)
SOURCE_PG_USER=ecommerce
SOURCE_PG_PASSWORD=ecommerce
SOURCE_PG_DB=ecommerce

# ClickHouse destination.
# CLICKHOUSE_USER/PASSWORD is a bootstrap/admin identity used only to
# provision the scoped ETL user below (clickhouse/init/01_peerdb_etl_user.sh)
# -- use it for ad-hoc operator queries (scripts/verify_cdc.sh,
# scripts/mirror_status.sh), never for the PeerDB peer itself.
CLICKHOUSE_USER=ch_admin
CLICKHOUSE_PASSWORD=ch_admin_password

# CLICKHOUSE_ETL_USER/PASSWORD is the least-privilege user PeerDB's
# ClickHouse peer actually connects as (see scripts/create_mirror.sql).
# If you change these, update the matching CREATE PEER statement in
# scripts/create_mirror.sql too -- it isn't templated from .env.
CLICKHOUSE_ETL_USER=peerdb_etl
CLICKHOUSE_ETL_PASSWORD=peerdb_etl_password

# Host port for peerdb-ui. Default avoids colliding with the port 3000 that
# a lot of other local dev servers (Next.js, etc.) already claim.
PEERDB_UI_PORT=3001
